# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Credentials (injected by platform at runtime)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD="placeholder_password"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="placeholder_admin_password"

# Optional External Licensed Cricket Provider Configuration
CRICKET_PROVIDER_MODE="mock"
CRICKET_PROVIDER_API_KEY="YOUR_LICENSED_PROVIDER_KEY"
CRICKET_PROVIDER_BASE_URL="https://api.example-cricket-provider.com/v1"
CRICKET_PROVIDER_CACHE_TTL_SECONDS="30"
